{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Rename this per audit: it becomes <name>.<your-subdomain>.workers.dev.
  "name": "arcscore-audit",
  "main": ".open-next/worker.js",
  // Build the site whenever Wrangler deploys, so Cloudflare's default
  // `npx wrangler deploy` (dashboard Git builds included) works with no
  // build command, variables or secrets set anywhere.
  "build": { "command": "npx opennextjs-cloudflare build" },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference, required by OpenNext; must match "name" above.
    { "binding": "WORKER_SELF_REFERENCE", "service": "arcscore-audit" }
  ],
  "observability": { "enabled": true }
  // No variables or secrets are needed: the public site renders without any.
}
